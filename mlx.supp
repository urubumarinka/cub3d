   match-leak-kinds: reachable
   fun:calloc
   fun:XkbAllocClientMap
   fun:_XkbReadGetMapReply
   fun:XkbGetUpdatedMap
   fun:XkbGetMap
   obj:/usr/lib/x86_64-linux-gnu/libX11.so.6.4.0
   fun:XkbKeycodeToKeysym
