# Generic X11/libXcb allocations (system library, not application code)
{
   x11_generic_allocations
   Memcheck:Leak
   match-leak-kinds: reachable
   obj:/usr/lib/x86_64-linux-gnu/libX11.so*
}

{
   xcb_generic_allocations
   Memcheck:Leak
   match-leak-kinds: reachable
   obj:/usr/lib/x86_64-linux-gnu/libxcb.so*
}

{
   libxext_generic_allocations
   Memcheck:Leak
   match-leak-kinds: reachable
   obj:/usr/lib/x86_64-linux-gnu/libXext.so*
}

# X11 uninitialised data in system calls (expected behavior)
{
   x11_writev_uninit
   Memcheck:Param
   writev(vector[0])
   fun:writev
}

# Catch ALL X11/libXcb reachable allocations not covered above (any source)
{
   x11_malloc_all
   Memcheck:Leak
   match-leak-kinds: reachable
   fun:malloc
   obj:/usr/lib/x86_64-linux-gnu/libX11.so*
}

